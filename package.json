{
  "name": "overdraw",
  "productName": "Overdraw",
  "version": "1.0.0",
  "description": "Draw, annotate and diagram on top of anything on your screen.",
  "author": "Overdraw",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run assets && electron-vite dev",
    "build": "npm run assets && electron-vite build && node scripts/verify-preload.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "assets": "node scripts/copy-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run typecheck && npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:zip": "npm run typecheck && npm run build && electron-builder --win zip",
    "shortcut": "electron scripts/shortcut.cjs"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@types/node": "22.18.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.7.0",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "perfect-freehand": "1.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.105.1"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "mermaid": {
      "katex": "0.18.11"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
